# Website API (apps/api) — local development template.
# `make api-env` copies this to .env. Placeholders only: never put real
# credentials here. Production values live in Railway's variables.

# development | test | production  (production disables /docs and enforces a strong IP_HASH_SECRET)
ENVIRONMENT=development

# docker-compose.yml (local Postgres on host port 5433)
POSTGRES_USER=nyamia_web
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=nyamia_web

# asyncpg URL; postgres:// and postgresql:// are rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://nyamia_web:local-dev-only@localhost:5433/nyamia_web

# HMAC key for client-IP hashing (rate limiting). Production: >= 32 random chars,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
IP_HASH_SECRET=change-me-local-dev-only

# Reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = ignore X-Forwarded-For (local). Set from the real Vercel → Railway chain.
TRUSTED_PROXY_HOP_COUNT=0

# Version of the privacy notice the form must send (privacy_version).
PRIVACY_VERSION=2026-10-30

LOG_LEVEL=INFO
