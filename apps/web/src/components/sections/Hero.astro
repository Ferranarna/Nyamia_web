---
import HeroProduct from '../mockups/HeroProduct.astro'
import Icon from '../ui/Icon.astro'
import { buttonClass } from '../ui/button'
import { getDictionary, type Locale } from '../../i18n'
import { ANCHORS } from '../../i18n/routes'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = getDictionary(locale)
const beats = t.hero.tagline.replace(/\.$/, '').split(/,\s*/)
const last = beats.pop() ?? ''
---

<section class="brand-wash relative overflow-hidden pt-10 pb-6 lg:pt-6" aria-labelledby="hero-title">
  <div class="mx-auto max-w-[77.5rem] px-5 sm:px-6">
    <div class="hero-text mx-auto flex max-w-[60rem] flex-col items-start sm:items-center sm:text-center">
      <p
        class="inline-flex items-center gap-2 rounded-pill bg-brand-100 px-3 py-1 text-sm font-medium text-brand-700"
        style="--i:0"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        {t.hero.eyebrow}
      </p>
      <h1 id="hero-title" class="mt-5 max-w-[14ch] text-display text-text" style="--i:1">
        {t.hero.headline}
      </h1>
      <p class="mt-4 text-title font-medium text-text-muted" style="--i:2">
        <Icon name="sparkle" size={20} class="mr-1 inline-block -translate-y-0.5 text-accent-500" />
        {beats.join(', ')}, <span class="text-brand-700">{last}</span>.
      </p>
      <p class="mt-4 max-w-[48rem] text-lead text-text-muted" style="--i:3">
        {t.hero.sub}
      </p>
      <div class="mt-6 flex w-full flex-col gap-3 sm:w-auto sm:flex-row" style="--i:4">
        <a href={`#${ANCHORS.demo}`} class={buttonClass('primary', 'lg')} data-cta="hero">
          {t.hero.ctaPrimary}
          <Icon
            name="arrow-right"
            size={18}
            class="transition-transform duration-150 group-hover/btn:translate-x-[3px]"
          />
        </a>
        <a href={`#${ANCHORS.howItWorks}`} class={buttonClass('secondary', 'lg')}>
          {t.hero.ctaSecondary}
        </a>
      </div>
      <p class="mt-3 text-sm text-text-muted" style="--i:5">
        {t.hero.note}
      </p>
    </div>
    <HeroProduct locale={locale} />
  </div>
</section>
