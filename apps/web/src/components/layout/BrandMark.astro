---
import { Image } from 'astro:assets'
import logo from '@nyamia/brand/assets/logo-original.png'

interface Props {
  name: string
  size?: number
  class?: string
}
const { name, size = 32, class: className } = Astro.props
---

<span class:list={['flex items-center gap-2', className]}>
  <Image
    src={logo}
    alt=""
    width={size}
    height={size}
    densities={[1, 2]}
    loading="eager"
    class="h-8 w-8 rounded-control"
    data-logo
  />
  <span class="text-lg font-semibold tracking-tight text-text">{name}</span>
</span>
